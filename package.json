{
  "name": "dialog-spy-bot",
  "version": "1.0.0",
  "description": "Telegram bot for tracking edited and deleted messages via Telegram Business API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "telegram",
    "bot",
    "business",
    "spy",
    "messages"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@types/node-cache": "^4.2.5",
    "dotenv": "^16.3.1",
    "moment": "^2.30.1",
    "node-cache": "^5.1.2",
    "redis": "^5.5.6",
    "telegraf": "^4.15.6"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "bun-types": "^1.2.17",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
