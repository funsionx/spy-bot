# Telegram Bot токен
BOT_TOKEN=your_bot_token_here

# ID владельца бота (ваш Telegram user ID)
OWNER_ID=123456789

# Язык бота (ru/en)
BOT_LANGUAGE=ru

# Тип кэша: memory (node-cache) или redis
CACHE_TYPE=memory

# Время жизни кэша в секундах (по умолчанию 120 = 2 минуты)
CACHE_TTL=120

# Redis URL (для CACHE_TYPE=redis)
REDIS_URL=redis://localhost:6379

# Пароль Redis (для docker-compose)
REDIS_PASSWORD=mypassword

# S3 Настройки
S3_BUCKET=your-s3-bucket-name
S3_REGION=your-s3-region
S3_ENDPOINT=https://storage.yandexcloud.net
S3_KEY=your-aws-access-key-id
S3_SECRET=your-aws-secret-access-key

# Режим разработки (true/false) - включает дополнительное логирование событий
DEV_MODE=false 