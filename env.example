# Telegram Bot токен
BOT_TOKEN=your_bot_token_here

# ID владельца бота (ваш Telegram user ID)
OWNER_ID=123456789

# Тип кэша: memory (node-cache) или redis
CACHE_TYPE=memory

# Время жизни кэша в секундах (по умолчанию 120 = 2 минуты)
CACHE_TTL=120

# Redis URL (для CACHE_TYPE=redis)
REDIS_URL=redis://localhost:6379

# Пароль Redis (для docker-compose)
REDIS_PASSWORD=mypassword

# Режим разработки (включает дополнительное логирование)
DEV_MODE=false

S3_KEY=your_s3_access_key
S3_SECRET=your_s3_secret_key
S3_BUCKET=your_bucket_name
S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net 