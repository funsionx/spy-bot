# Токен вашего Telegram бота (получите у @BotFather)
BOT_TOKEN=

# ID владельца бота (ваш Telegram ID, получите у @userinfobot)
OWNER_ID=

# Основной публичный URL без завершающего слэша
WEBHOOK_URL=
# Статический путь вебхука Telegram (должен совпадать с сервером)
TELEGRAM_WEBHOOK_PATH=/telegraf/truthteller
# Ссылка на покупку Premium в Tribute (WebApp/Stars/TON)
TRIBUTE_PREMIUM_URL=https://t.me/tribute/app?startapp=sxl5

# Порт, на котором будет работать веб-сервер
PORT=3000

# API-ключ для проверки подписи веб-хуков от Tribute
TRIBUTE_API_KEY=

# Язык бота (ru/en, по умолчанию ru)
BOT_LANGUAGE=ru

# --- Настройки Redis ---
# URL для подключения к Redis (внутри Docker используйте redis://redis:6379)
REDIS_URL=redis://redis:6379
# Пароль для Redis (измените на свой безопасный пароль!)
REDIS_PASSWORD=your_secure_redis_password_here

# Время жизни кэша сообщений в Redis (в секундах, по умолчанию 120)
CACHE_TTL=120

# --- Настройки MongoDB ---
# Имя пользователя MongoDB (измените на свой!)
MONGO_INITDB_ROOT_USERNAME=spybot
# Пароль MongoDB (измените на свой безопасный пароль!)
MONGO_INITDB_ROOT_PASSWORD=your_secure_mongo_password_here
# Порт MongoDB для внешнего подключения (для Mongo Compass)
MONGO_PORT=27017
# URI для подключения изнутри Docker (используется приложением)
MONGODB_URI=mongodb://spybot:your_secure_mongo_password_here@mongo:27017/spybot?authSource=admin

# --- Настройки S3-совместимого хранилища ---
# Имя бакета
S3_BUCKET=
# Регион
S3_REGION=
# Endpoint URL
S3_ENDPOINT=
# Ключ доступа (Access Key)
S3_KEY=
# Секретный ключ (Secret Key)
S3_SECRET=

# Режим разработки (true/false) - включает дополнительное логирование событий
DEV_MODE=false 